{
  "name": "condors-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "env-dev": "dotenv-dev DATABASE_URL -i localhost",
    "db:dev": "pnpm run db:up && sleep 1 && pnpm run db:push && pnpm run db:seed:all",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:push": "pnpm run env-dev -- pnpm exec drizzle-kit push --config drizzle.config.ts",
    "db:push:prd": "dotenvx run -- pnpm exec drizzle-kit push --config drizzle.config.ts",
    "db:seed:all": "pnpm run db:seed:tokens && pnpm run db:seed:rides",
    "db:seed:rides": "dotenvx run -- tsx scripts/db-seed-rides.ts",
    "db:seed:tokens": "dotenvx run -- tsx scripts/db-seed-tokens.ts",
    "dev": "next dev --turbo --port 5210",
    "build": "NODE_ENV=production next build",
    "start": "next start",
    "fmt": "oxfmt .",
    "lint": "oxlint --fix .",
    "check": "tsc --noEmit",
    "test": "NO_CHECK_ENV_VARS=1 vitest",
    "test:dev": "IN_TEST=1 next dev --turbo --port 2999",
    "test:e2e": "dotenvx run -- vitest run --config vitest-e2e.config.js --no-file-parallelism",
    "ci:fmt": "oxfmt --check .",
    "ci:test": "NO_CHECK_ENV_VARS=1 vitest run",
    "all": "pnpm run fmt && pnpm run lint && pnpm run check && pnpm run ci:test",
    "backfill": "dotenvx run -- tsx scripts/backfill-route-names.ts",
    "notify": "dotenvx run -- tsx scripts/notify-chris.ts",
    "script": "dotenvx run -- tsx",
    "knip": "knip"
  },
  "dependencies": {
    "@mapbox/polyline": "^1.2.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-table": "^9.3.1",
    "better-auth": "^1.7.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dotenv-dev": "^0.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.61.0",
    "maplibre-gl": "^6.15.0",
    "nanoid": "^6.0.2",
    "next": "^16.4.3",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.2",
    "pg": "^8.23.1",
    "posthog-node": "^5.57.1",
    "pulltorefreshjs": "^0.1.22",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "3.10.1",
    "remark-gfm": "^4.0.1",
    "slugify": "^1.6.9",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zod-form-data": "^3.0.4"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.38.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/mapbox__polyline": "^1.0.5",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/pulltorefreshjs": "^0.1.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "jsdom": "^30.1.3",
    "knip": "^6.42.1",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": ">=12.15.0 <13.0.0"
  },
  "packageManager": "pnpm@12.15.0"
}
