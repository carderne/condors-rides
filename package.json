{
  "name": "condors-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:dev": "npm run db:up && sleep 1 && npm run db:push",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:push": "dotenvx run -- npx drizzle-kit push --config drizzle.config.ts",
    "db:seed:rides": "dotenvx run -- tsx scripts/db-seed-rides.ts",
    "dev": "next dev --turbo",
    "build": "NODE_ENV=production next build",
    "start": "next start",
    "fmt": "prettier --log-level warn --write .",
    "lint": "next lint",
    "check": "tsc --noEmit",
    "test": "NO_CHECK_ENV_VARS=1 vitest",
    "test:dev": "IN_TEST=1 next dev --turbo --port 2999",
    "test:e2e": "dotenvx run -- vitest run --config vitest-e2e.config.js --no-file-parallelism",
    "ci:fmt": "prettier --check .",
    "ci:test": "NO_CHECK_ENV_VARS=1 vitest run",
    "all": "npm run fmt && npm run lint && npm run check && npm run ci:test"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "better-auth": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.40.0",
    "drizzle-zod": "^0.7.0",
    "lucide-react": "^0.479.0",
    "nanoid": "^5.1.3",
    "next": "^15.2.1",
    "pg": "^8.13.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "slugify": "^1.6.6",
    "sonner": "^2.0.1",
    "tailwind-merge": "^3.0.2",
    "zod": "^3.24.2",
    "zod-form-data": "^2.0.7"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.38.4",
    "@eslint/eslintrc": "^3.3.0",
    "@eslint/js": "^9.22.0",
    "@next/eslint-plugin-next": "^15.2.1",
    "@tailwindcss/postcss": "^4.0.12",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "drizzle-kit": "^0.30.5",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-react": "^7.37.4",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "prettier-plugin-organize-imports": "^4.1.0",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4.0.12",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.0.8"
  },
  "engines": {
    "node": ">=22.0.0 <23.0.0",
    "npm": ">=10.0.0 <11.0.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.1"
    },
    "@esbuild-kit/esm-loader": {
      "esbuild": "^0.25.1"
    },
    "drizzle-kit": {
      "esbuild": "^0.25.1"
    }
  }
}
