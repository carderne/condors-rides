{
  "name": "condors-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "env-dev": "dotenv-dev DATABASE_URL -i localhost",
    "db:dev": "pnpm run db:up && sleep 1 && pnpm run db:push && pnpm run db:seed:all",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:push": "pnpm run env-dev -- pnpm exec drizzle-kit push --config drizzle.config.ts",
    "db:push:prd": "dotenvx run -- pnpm exec drizzle-kit push --config drizzle.config.ts",
    "db:seed:all": "pnpm run db:seed:tokens && pnpm run db:seed:rides",
    "db:seed:rides": "dotenvx run -- tsx scripts/db-seed-rides.ts",
    "db:seed:tokens": "dotenvx run -- tsx scripts/db-seed-tokens.ts",
    "dev": "next dev --turbo --port 5210",
    "build": "NODE_ENV=production next build",
    "start": "next start",
    "fmt": "prettier --log-level warn --write .",
    "lint": "eslint --fix . --ext .js,.jsx,.ts,.tsx",
    "check": "tsc --noEmit",
    "test": "NO_CHECK_ENV_VARS=1 vitest",
    "test:dev": "IN_TEST=1 next dev --turbo --port 2999",
    "test:e2e": "dotenvx run -- vitest run --config vitest-e2e.config.js --no-file-parallelism",
    "ci:fmt": "prettier --check .",
    "ci:test": "NO_CHECK_ENV_VARS=1 vitest run",
    "all": "pnpm run fmt && pnpm run lint && pnpm run check && pnpm run ci:test",
    "knip": "knip"
  },
  "dependencies": {
    "@mapbox/polyline": "^1.2.1",
    "@radix-ui/react-alert-dialog": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.4",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.11",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-select": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@tanstack/react-table": "^8.21.3",
    "better-auth": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv-dev": "^0.1.1",
    "drizzle-orm": "^0.40.0",
    "lucide-react": "^0.479.0",
    "maplibre-gl": "^5.3.1",
    "nanoid": "^5.1.3",
    "next": "^15.2.1",
    "next-themes": "^0.4.6",
    "pg": "^8.13.3",
    "posthog-node": "^4.17.1",
    "pulltorefreshjs": "^0.1.22",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "slugify": "^1.6.6",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.0.2",
    "web-push": "^3.6.7",
    "zod": "^3.24.2",
    "zod-form-data": "^2.0.7"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.38.4",
    "@eslint/eslintrc": "^3.3.0",
    "@eslint/js": "^9.22.0",
    "@next/eslint-plugin-next": "^15.2.1",
    "@tailwindcss/postcss": "^4.0.12",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.2.0",
    "@types/mapbox__polyline": "^1.0.5",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "@types/pulltorefreshjs": "^0.1.7",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^4.3.4",
    "drizzle-kit": "^0.30.5",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-react": "^7.37.4",
    "jsdom": "^26.0.0",
    "knip": "^5.64.1",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "prettier-plugin-organize-imports": "^4.1.0",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4.0.12",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.0.8"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": ">=10.13.0 <11.0.0"
  }
}
