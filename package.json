{
  "name": "condors-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "env-dev": "dotenv-dev DATABASE_URL -i localhost",
    "db:dev": "pnpm run db:up && sleep 1 && pnpm run db:push && pnpm run db:seed:all",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:push": "pnpm run env-dev -- pnpm exec drizzle-kit push --config drizzle.config.ts",
    "db:push:prd": "dotenvx run -- pnpm exec drizzle-kit push --config drizzle.config.ts",
    "db:seed:all": "pnpm run db:seed:tokens && pnpm run db:seed:rides",
    "db:seed:rides": "dotenvx run -- tsx scripts/db-seed-rides.ts",
    "db:seed:tokens": "dotenvx run -- tsx scripts/db-seed-tokens.ts",
    "dev": "next dev --turbo --port 5210",
    "build": "NODE_ENV=production next build",
    "start": "next start",
    "fmt": "prettier --log-level warn --write .",
    "lint": "eslint --fix . --ext .js,.jsx,.ts,.tsx",
    "check": "tsc --noEmit",
    "test": "NO_CHECK_ENV_VARS=1 vitest",
    "test:dev": "IN_TEST=1 next dev --turbo --port 2999",
    "test:e2e": "dotenvx run -- vitest run --config vitest-e2e.config.js --no-file-parallelism",
    "ci:fmt": "prettier --check .",
    "ci:test": "NO_CHECK_ENV_VARS=1 vitest run",
    "all": "pnpm run fmt && pnpm run lint && pnpm run check && pnpm run ci:test",
    "backfill": "dotenvx run -- tsx scripts/backfill-route-names.ts",
    "notify": "dotenvx run -- tsx scripts/notify-chris.ts",
    "script": "dotenvx run -- tsx",
    "knip": "knip"
  },
  "dependencies": {
    "@mapbox/polyline": "^1.2.1",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-table": "^8.21.3",
    "better-auth": "^1.4.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv-dev": "^0.1.1",
    "drizzle-orm": "^0.45.1",
    "lucide-react": "^0.562.0",
    "maplibre-gl": "^5.15.0",
    "nanoid": "^5.1.6",
    "next": "^16.2.6",
    "next-themes": "^0.4.6",
    "pg": "^8.16.3",
    "posthog-node": "^5.18.1",
    "pulltorefreshjs": "^0.1.22",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "recharts": "2.15.4",
    "remark-gfm": "^4.0.1",
    "slugify": "^1.6.6",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.4",
    "zod-form-data": "^3.0.1"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.51.4",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@next/eslint-plugin-next": "16.1.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.1",
    "@types/mapbox__polyline": "^1.0.5",
    "@types/node": "^24.1.0",
    "@types/pg": "^8.16.0",
    "@types/pulltorefreshjs": "^0.1.7",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.1.2",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "jsdom": "^27.4.0",
    "knip": "^5.79.0",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.51.0",
    "vite-tsconfig-paths": "^6.0.3",
    "vitest": "^4.0.16"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": ">=10.17.1 <11.0.0"
  },
  "packageManager": "pnpm@10.17.1"
}
